{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(eot|otf|ttf|ttc|woff|woff2|font.css)",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**/*.@(js|wasm|css|png|jpg|jpeg|gif|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/@(index.html|flutter_service_worker.js|firebase-messaging-sw.js|version.json|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "web": {
        "default": {
          "projectId": "fir-walkrunbike-f6792",
          "appId": "1:1033737834173:web:c876c9283b31a46abcb1d4",
          "fileOutput": "web/firebase-config.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "fir-walkrunbike-f6792",
          "appId": "1:1033737834173:ios:37ce13e3a3ca8737bcb1d4"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "fir-walkrunbike-f6792",
          "configurations": {
            "ios": "1:1033737834173:ios:37ce13e3a3ca8737bcb1d4",
            "android": "1:1033737834173:android:16354e7b6cc5495fbcb1d4",
            "web": "1:1033737834173:web:c876c9283b31a46abcb1d4"
          }
        }
      }
    }
  }
}